{
  "name": "minerva-ranger",
  "version": "0.4.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite --mode cloud",
    "build": "vite build",
    "build:cloud": "vite build --mode cloud",
    "build:cloud:development": "cross-env CLOUDFLARE_ENV=development vite build --mode cloud",
    "build:cloud:production": "cross-env CLOUDFLARE_ENV=production vite build --mode cloud",
    "release:cloud:development": "node scripts/cloud-release.cjs development",
    "release:cloud:production": "node scripts/cloud-release.cjs production --confirm-production",
    "validate:cloud-imports": "node scripts/validate-cloud-imports.cjs",
    "test": "node --test \"tests/*.test.mjs\" \"tests/*.test.cjs\"",
    "test:cloud": "vitest run --config vitest.config.mjs",
    "types:cloud": "wrangler types worker-configuration.d.ts",
    "check:cloud": "wrangler types worker-configuration.d.ts --check && vitest run --config vitest.config.mjs && vite build --mode cloud",
    "test:electron-sqlite": "node scripts/run-electron-sqlite-probe.cjs",
    "test:electron-app": "node scripts/run-electron-app-smoke.cjs",
    "test:packaged-app": "node scripts/run-packaged-app-smoke.cjs",
    "test:installer": "npm run dist:installer-smoke && node scripts/run-installer-smoke.cjs",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:installer-smoke": "npm run build && electron-builder --config scripts/electron-builder-smoke.config.cjs",
    "check": "oxlint . && eslint . --cache",
    "lint": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/ios": "^8.0.2",
    "dompurify": "^3.4.13",
    "jose": "^6.2.9",
    "marked": "^18.0.9",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.42.0",
    "eslint-plugin-vue": "~10.7.0",
    "globals": "^17.2.0",
    "jsdom": "^29.1.1",
    "oxlint": "~1.42.0",
    "postcss": "^8.5.6",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.minerva.ranger",
    "productName": "MinervaRanger",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer/installer.nsh"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "icon": "src/assets/favicon.png"
    }
  }
}
